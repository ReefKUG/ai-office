// Database version of docs/office-contracts.ts.
// Artifacts reference each other by ID (foreign keys), never embed each other.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Spec {
  id                 String   @id @default(cuid())
  title              String
  description        String
  acceptanceCriteria String[]
  createdAt          DateTime @default(now())

  codes   Code[]
  reviews Review[]
  tasks   Task[]
}

model Code {
  id               String   @id @default(cuid())
  specId           String
  spec             Spec     @relation(fields: [specId], references: [id])
  revision         Int // 1 on first Dev pass, incremented on each revision
  previousReviewId String? // the review this revision answers (plain ID, no relation to avoid a Code <-> Review cycle)
  code             String
  createdAt        DateTime @default(now())

  reviews  Review[]
  llmCalls LlmCall[]
  tasks    Task[]
}

model Review {
  id        String   @id @default(cuid())
  specId    String
  spec      Spec     @relation(fields: [specId], references: [id])
  codeId    String
  code      Code     @relation(fields: [codeId], references: [id])
  passed    Boolean
  feedback  String
  createdAt DateTime @default(now())

  llmCalls LlmCall[]
  tasks    Task[]
}

// One row per LLM call. A build call fills codeId, a review call fills reviewId.
model LlmCall {
  id           String   @id @default(cuid())
  department   String
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal  @db.Decimal(12, 6)
  durationMs   Int
  codeId       String?
  code         Code?    @relation(fields: [codeId], references: [id])
  reviewId     String?
  review       Review?  @relation(fields: [reviewId], references: [id])
  createdAt    DateTime @default(now())
}

// Orchestrator state machine. Not an artifact: it tracks where a task is in the
// Build <-> Review loop so each step can run on its own (and later as a BullMQ job).
enum TaskStatus {
  BUILDING
  REVIEWING
  PASSED
  FAILED_MAX_LOOPS
  FAILED_BUDGET
}

model Task {
  id           String     @id @default(cuid())
  specId       String
  spec         Spec       @relation(fields: [specId], references: [id])
  status       TaskStatus @default(BUILDING)
  loop         Int        @default(0) // Build passes done so far
  totalCostUsd Decimal    @default(0) @db.Decimal(12, 6)
  lastCodeId   String?
  lastCode     Code?      @relation(fields: [lastCodeId], references: [id])
  lastReviewId String?
  lastReview   Review?    @relation(fields: [lastReviewId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
